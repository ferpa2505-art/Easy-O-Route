{
  "name": "easy-o-route",
  "version": "1.1.0",
  "description": "Facilitador de Configuracao do OmniRoute - CLI para gerenciar provedores, combos e chaves API",
  "main": "dist/index.js",
  "files": [
    "dist",
    "scripts",
    "panel",
    "docs",
    "README.md",
    "LICENSE",
    "SECURITY.md"
  ],
  "bin": {
    "easy-o-route": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "panel": "node panel/server.js",
    "test": "jest",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write src/**/*.ts"
  },
  "keywords": [
    "omniroute",
    "ai",
    "llm",
    "cli",
    "facilitador",
    "economizar",
    "tokens",
    "providers",
    "combo"
  ],
  "author": "Fernando Paulino (ferpa2505-art)",
  "license": "MIT",
  "homepage": "https://github.com/ferpa2505-art/Easy-O-Route",
  "repository": {
    "type": "git",
    "url": "https://github.com/ferpa2505-art/Easy-O-Route.git"
  },
  "bugs": {
    "url": "https://github.com/ferpa2505-art/Easy-O-Route/issues"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "chalk": "^5.3.0",
    "inquirer": "^9.2.11",
    "axios": "^1.6.2",
    "figlet": "^1.7.0",
    "ora": "^8.0.1",
    "boxen": "^7.1.1",
    "configstore": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/configstore": "^6.0.2",
    "@types/inquirer": "^9.0.7",
    "@types/figlet": "^1.5.8",
    "@types/ora": "^3.2.0",
    "typescript": "^5.3.0",
    "ts-node": "^10.9.2",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.12",
    "ts-jest": "^29.1.1",
    "eslint": "^8.56.0",
    "@typescript-eslint/eslint-plugin": "^6.17.0",
    "@typescript-eslint/parser": "^6.17.0",
    "prettier": "^3.1.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
